{
  "name": "autopilot-ai",
  "version": "1.28.0",
  "description": "autopilot (formerly kimiflare): a terminal coding agent for any model with your own key: OpenRouter, Anthropic, OpenAI, Gemini, Bedrock, Vertex, Ollama and more. Per-turn cost, web search, GitHub, headless browser, LSP, MCP, local memory.",
  "keywords": [
    "autopilot",
    "kimiflare",
    "ai",
    "cli",
    "coding-agent",
    "terminal",
    "kimi",
    "openrouter",
    "vision",
    "image-understanding",
    "llm",
    "code-generation",
    "tui",
    "mcp",
    "model-context-protocol",
    "anthropic",
    "openai",
    "gemini",
    "ollama",
    "multi-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinameraji/autopilot.git"
  },
  "homepage": "https://directionallylocal.com/autopilot/",
  "bugs": "https://github.com/sinameraji/autopilot/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "autopilot": "bin/autopilot.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "PLAN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/**/*.test.mjs\"",
    "record-demos": "vhs demos/*.tape",
    "start": "node bin/autopilot.mjs",
    "prepack": "node scripts/prune-bundled-deps.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hotcell/sdk": "^0.1.23",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^12.1.0",
    "imapflow": "2.2.5",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "postal-mime": "4.0.4",
    "react": "^19.2.0",
    "turndown": "^7.2.0",
    "uqr": "0.1.3"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "camouflage-tui": "^2.8.1",
    "isolated-vm": "^6.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "bundleDependencies": [
    "@hotcell/sdk",
    "@modelcontextprotocol/sdk",
    "better-sqlite3",
    "commander",
    "imapflow",
    "ink",
    "ink-select-input",
    "jpeg-js",
    "pngjs",
    "postal-mime",
    "react",
    "turndown",
    "uqr"
  ]
}
