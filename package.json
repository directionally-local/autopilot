{
  "name": "autopilot-ai",
  "version": "1.23.0",
  "description": "autopilot (formerly kimiflare): a terminal coding agent that runs any OpenRouter model with your own key. Per-turn billed cost, web search, GitHub, headless browser, LSP, MCP, local memory.",
  "keywords": [
    "autopilot",
    "kimiflare",
    "ai",
    "cli",
    "coding-agent",
    "terminal",
    "kimi",
    "k2.6",
    "openrouter",
    "vision",
    "image-understanding",
    "llm",
    "code-generation",
    "tui",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinameraji/autopilot.git"
  },
  "homepage": "https://github.com/sinameraji/autopilot#readme",
  "bugs": "https://github.com/sinameraji/autopilot/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "autopilot": "bin/autopilot.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "PLAN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "build:remote": "npm run build:remote-agent",
    "build:remote-agent": "cd remote/agent && npx tsup",
    "dev": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts src/**/*.test.tsx",
    "record-demos": "vhs demos/*.tape",
    "start": "node bin/autopilot.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hotcell/sdk": "^0.1.23",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^12.1.0",
    "ink": "^7.0.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "turndown": "^7.2.0",
    "typescript": "^5.7.2",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "camouflage-tui": "^2.6.1",
    "isolated-vm": "^6.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "bundleDependencies": [
    "@hotcell/sdk",
    "@modelcontextprotocol/sdk",
    "better-sqlite3",
    "commander",
    "ink",
    "ink-select-input",
    "ink-spinner",
    "ink-text-input",
    "qrcode",
    "react",
    "turndown",
    "typescript",
    "vscode-languageserver-protocol"
  ]
}
