node_modules
dist/

# Generated by `npm pack`/`npm publish` (scripts/npm-shrinkwrap.mjs) so the
# published tarball pins the production tree. Never commit it: npm prefers
# npm-shrinkwrap.json over package-lock.json, and a production-only copy at the
# repo root makes `npm ci` fail on every devDependency.
/npm-shrinkwrap.json
.npm-cache/
*.log
.env
.env.*
!.env.example
.DS_Store

# user data that must never leak to git
~
.config/
sessions/
coverage/
.kimiflare/
.autopilot/
changelog-*.png

# raw eval output (absolute paths, traces); commit evals/results/*.json summaries only
evals/results/run-*/
